<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#8b5cf6"><title>PASONG Producer Checkout</title><script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>*{box-sizing:border-box}body{margin:0;background:#080810;color:#fff;font-family:Arial,Helvetica,sans-serif}.wrap{max-width:980px;margin:auto;padding:18px}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.logo{font-size:24px;font-weight:900;color:#fff;text-decoration:none}.logo b{color:#c084fc}.back{color:#aaa;text-decoration:none}.card{background:#11111b;border:1px solid #2a2a3a;border-radius:24px;overflow:hidden;box-shadow:0 24px 80px #0008}.hero{padding:25px;background:radial-gradient(circle at 90% 10%,#ec489933,transparent 35%),radial-gradient(circle at 10% 90%,#8b5cf633,transparent 40%)}.tag{font-size:11px;letter-spacing:2px;color:#c084fc;font-weight:900}.hero h1{margin:8px 0;font-size:32px}.muted{color:#9b9bab;line-height:1.6}.grid{display:grid;grid-template-columns:280px 1fr;gap:25px;padding:25px}.cover{width:100%;aspect-ratio:1;object-fit:cover;border-radius:18px;background:#191923;border:1px solid #303044}.title{font-size:25px;font-weight:900}.meta{color:#aaaabd;line-height:1.8;margin:8px 0 18px}.plans{display:grid;grid-template-columns:1fr 1fr;gap:12px}.plan{padding:17px;border:1px solid #34344a;background:#0b0b14;border-radius:14px;cursor:pointer;color:#fff;text-align:left}.plan.active{border-color:#8b5cf6;box-shadow:0 0 0 1px #8b5cf6}.plan small{display:block;color:#999;margin-bottom:6px}.plan strong{font-size:19px;color:#c084fc}.section{border-top:1px solid #2a2a3a;padding:25px}.section h2{font-size:19px}.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{margin:12px 0}.field label{display:block;color:#d9d9e5;font-size:13px;font-weight:700;margin-bottom:7px}.field input,.field textarea{width:100%;padding:13px;border-radius:11px;border:1px solid #38384c;background:#090912;color:#fff;outline:0}.field textarea{min-height:85px;resize:vertical}.summary{background:#090912;border:1px solid #34344a;border-radius:14px;padding:16px;margin-bottom:18px}.sum{display:flex;justify-content:space-between;gap:12px;padding:7px 0;color:#aaa}.total{border-top:1px solid #2a2a3a;margin-top:8px;padding-top:13px;color:#fff;font-size:19px;font-weight:900}.total strong{color:#c084fc}.methods{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.method{border:1px solid #37374b;background:#181823;border-radius:14px;padding:14px;color:#fff;cursor:pointer;text-align:left}.method.active{border-color:#8b5cf6;box-shadow:0 0 0 1px #8b5cf6}.method .icon{height:26px;display:flex;align-items:center;gap:7px;font-weight:900}.method img{height:22px;max-width:75px;object-fit:contain}.pay{width:100%;border:0;border-radius:14px;padding:15px;margin-top:14px;background:linear-gradient(135deg,#8b5cf6,#ec4899);color:#fff;font-weight:900;font-size:16px}.pay:disabled{opacity:.5}.status{display:none;padding:13px;border-radius:12px;margin-top:12px;line-height:1.5}.status.show{display:block}.ok{background:#12321f;border:1px solid #2c6945;color:#9be7bb}.bad{background:#351719;border:1px solid #713236;color:#ffb1b1}.info{background:#19142b;border:1px solid #3a2b5b;color:#cdb9ff}.hidden{display:none!important}footer{text-align:center;color:#777789;padding:25px;font-size:12px}@media(max-width:700px){.grid{grid-template-columns:1fr;padding:18px}.cover{max-width:300px;margin:auto}.row,.plans,.methods{grid-template-columns:1fr}.hero{padding:20px}.hero h1{font-size:27px}.section{padding:20px}}</style></head>
<body><div class="wrap"><div class="top"><a class="logo" href="index.html">◈ <b>PASONG</b></a><a class="back" href="javascript:history.back()">← Back</a></div><div id="loading" class="card hero">Loading secure checkout…</div>
<div id="checkout" class="card hidden"><div class="hero"><div class="tag">PASONG PRODUCER MARKETPLACE</div><h1>Secure Checkout</h1><div class="muted">Choose a beat licence. Prices are converted for display only; PASONG charges the saved listing price and currency. Downloads and rights unlock only after verified payment.</div></div>
<div class="grid"><img id="cover" class="cover" alt="Beat cover"><div><div id="title" class="title">Beat</div><div id="meta" class="meta">Loading…</div><div class="plans" id="plans"></div><div class="muted" id="fxNote" style="font-size:12px;margin-top:12px"></div></div></div>
<div class="section"><h2>Customer details</h2><div class="row"><div class="field"><label>Name</label><input id="name" autocomplete="name" placeholder="Your full name"></div><div class="field"><label>Email</label><input id="email" type="email" autocomplete="email" placeholder="you@example.com"></div></div><div class="field"><label>Phone / WhatsApp</label><input id="phone" autocomplete="tel" placeholder="+256 701 234 567"></div><div class="field"><label>Message to producer (optional)</label><textarea id="message" placeholder="Any instructions for the producer…"></textarea></div></div>
<div class="section"><h2>Payment method</h2><div class="summary"><div class="sum"><span>Beat</span><span id="sTitle">—</span></div><div class="sum"><span>Licence</span><span id="sPackage">MP3 Lease</span></div><div class="sum"><span>Original listing price</span><span id="original">—</span></div><div class="sum total"><span>Display total</span><strong id="total">—</strong></div></div><div class="methods"><button class="method active" data-method="MTN"><div class="icon"><img src="https://cdn.simpleicons.org/mtn" alt=""> MTN MoMo</div></button><button class="method" data-method="AIRTEL"><div class="icon"><img src="https://cdn.simpleicons.org/airtel" alt=""> Airtel Money</div></button><button class="method" data-method="FLUTTERWAVE"><div class="icon"><img src="https://cdn.simpleicons.org/visa" alt=""><img src="https://cdn.simpleicons.org/mastercard" alt=""> Card</div></button></div><div id="mobileBox" class="field"><label>Mobile Money number</label><input id="mobile" type="tel" autocomplete="tel" placeholder="07XX XXX XXX"></div><button id="pay" class="pay">Pay with MTN MoMo</button><div id="status" class="status" role="status"></div></div></div><footer>© 2026 PASONG — Music. Opportunity. Support.</footer></div>
<script>
'use strict';
const SUPABASE_URL='https://mtufczmjlkvycarxylgh.supabase.co',SUPABASE_KEY='sb_publishable_XDIZ0_nd4PAYJy2Oz4VaxQ_R4Trs3VP',API='https://pasong-api.onrender.com';
const sb=supabase.createClient(SUPABASE_URL,SUPABASE_KEY),q=new URLSearchParams(location.search),beatId=q.get('beat')||q.get('id');let beat=null,producer=null,license=(q.get('license')||q.get('package')||'lease').toLowerCase(),method='MTN',sessionUser=null,displayCurrency='UGX',rates={UGX:1,USD:0.00026,GBP:0.00020,EUR:0.00024},country='';
const $=id=>document.getElementById(id);const first=(o,keys,d='')=>{for(const k of keys)if(o&&o[k]!=null&&String(o[k]).trim()!=='')return o[k];return d};
const cur=b=>String(first(b,['price_currency','currency'],'UGX')).toUpperCase();
const prices={mp3:b=>Number(first(b,['lease_mp3_price','lease_price','beat_lease_price'],0)),wav:b=>Number(first(b,['lease_wav_price'],0)),stems:b=>Number(first(b,['stems_price'],0)),exclusive:b=>Number(first(b,['exclusive_price','beat_exclusive_price','exclusive_rights_price'],0))};
function money(n,c){try{return new Intl.NumberFormat(undefined,{style:'currency',currency:c,maximumFractionDigits:c==='UGX'?0:2}).format(Number(n||0))}catch{return c+' '+Number(n||0).toLocaleString()}}
function originalPrice(){return beat?prices[license](beat):0}function displayPrice(){const p=originalPrice(),c=cur(beat);if(c===displayCurrency)return p;if(rates[c]&&rates[displayCurrency])return p/rates[c]*rates[displayCurrency];return p}
function msg(t,c='info'){const x=$('status');x.textContent=t;x.className='status show '+c}
async function detectCurrency(){try{let r=await fetch('https://ipwho.is/',{cache:'no-store'}),d=await r.json();if(d.success!==false){country=d.country_code||'';const map={UG:'UGX',GB:'GBP',FR:'EUR',DE:'EUR',IT:'EUR',ES:'EUR',PT:'EUR',NL:'EUR',BE:'EUR',IE:'EUR',AT:'EUR',FI:'EUR',GR:'EUR',LU:'EUR',CY:'EUR',MT:'EUR',SK:'EUR',SI:'EUR',EE:'EUR',LV:'EUR',LT:'EUR',US:'USD',CA:'USD',AU:'USD',NZ:'USD'};displayCurrency=map[country]||'USD'}}catch{displayCurrency='USD'}
 try{const r=await fetch('https://open.er-api.com/v6/latest/USD',{cache:'no-store'}),d=await r.json();if(d.result==='success'){const u=d.rates.UGX,g=d.rates.GBP,e=d.rates.EUR,usd=d.rates.USD;rates={UGX:1/u,USD:1,GBP:g,EUR:e};}}catch{} }
async function session(){const r=await sb.auth.getSession();return r.data.session}async function auth(){const s=await session();if(!s){msg('Please log in to your PASONG account first.','bad');setTimeout(()=>location.href='login.html?redirect='+encodeURIComponent(location.href),800);return null}return s}
function renderPlans(){const c=cur(beat),items=[['mp3','MP3 Lease'],['wav','WAV Lease'],['stems','Stems'],['exclusive','Exclusive Rights']];$('plans').innerHTML=items.map(([k,label])=>{const p=prices[k](beat),sold=k==='exclusive'&&(beat.is_exclusive_sold||beat.status==='sold_exclusive');return `<button class="plan ${license===k?'active':''}" data-license="${k}" ${!p||sold?'disabled':''}><small>${label}${sold?' · SOLD':''}</small><strong>${p?money(rates[c]&&rates[displayCurrency]?p/rates[c]*rates[displayCurrency]:p,displayCurrency):'Price not set'}</strong><div class="muted" style="font-size:11px;margin-top:6px">Original: ${p?money(p,c):'Not set'}</div></button>`}).join('');document.querySelectorAll('[data-license]').forEach(b=>b.onclick=()=>{license=b.dataset.license;renderPlans();updateSummary()})}
function updateSummary(){const c=cur(beat),p=originalPrice(),dp=displayPrice();$('sPackage').textContent=({mp3:'MP3 Lease',wav:'WAV Lease',stems:'Stems',exclusive:'Exclusive Rights'})[license];$('original').textContent=money(p,c);$('total').textContent=money(dp,displayCurrency);$('fxNote').textContent=`Buyer location: ${country||'not detected'} · Display currency: ${displayCurrency}. Conversion is an estimate for display; final charge uses ${money(p,c)}.`;document.querySelectorAll('[data-license]').forEach(b=>b.classList.toggle('active',b.dataset.license===license))}
function updateButton(){$('pay').textContent=({MTN:'Pay with MTN MoMo',AIRTEL:'Pay with Airtel Money',FLUTTERWAVE:'Pay with Visa / Mastercard'})[method]}
async function load(){if(!beatId){$('loading').textContent='No beat was selected.';return}try{await detectCurrency();const r=await sb.from('beats').select('*').eq('id',beatId).maybeSingle();if(r.error||!r.data)throw Error('Beat not found');beat=r.data;const pid=first(beat,['producer_id','artist_id'],'');if(pid){const p=await sb.from('artist_profiles').select('*').eq('id',pid).maybeSingle();producer=p.data||null}const title=first(beat,['title','beat_title','beat_name','name'],'Untitled Beat');$('title').textContent=title;$('sTitle').textContent=title;$('cover').src=first(beat,['cover_url','beat_cover_url','cover_image_url','artwork_url','image_url'],'https://ui-avatars.com/api/?name=Beat&background=171722&color=c084fc&bold=true');$('meta').textContent=`${first(producer,['performing_name','stage_name','artist_name','name'],'Producer')} · ${first(beat,['genre','music_genre'],'Beat')}${beat.bpm?' · '+beat.bpm+' BPM':''}${beat.key?' · Key: '+beat.key:''}`;const s=await session();sessionUser=s;if(s){$('name').value=first(s.user.user_metadata,['full_name','name','display_name'],'');$('email').value=s.user.email||''}if(!['mp3','wav','stems','exclusive'].includes(license))license='mp3';renderPlans();updateSummary();$('loading').classList.add('hidden');$('checkout').classList.remove('hidden')}catch(e){console.error(e);$('loading').textContent=e.message||'Unable to load checkout.'}}
async function pay(){const s=await auth();if(!s)return;const name=$('name').value.trim(),email=$('email').value.trim(),phone=$('mobile').value.trim();if(!name||!email){msg('Enter your name and email.','bad');return}if(method!=='FLUTTERWAVE'&&!/^(?:\+256|256|0)7\d{8}$/.test(phone.replace(/\s+/g,''))){msg('Enter a valid Uganda mobile-money number.','bad');return}if(!beat){msg('Invalid beat.','bad');return}if(!originalPrice()){msg('This licence has no valid price set.','bad');return}if(license==='exclusive'&&(beat.is_exclusive_sold||beat.status==='sold_exclusive')){msg('This beat is already exclusively sold.','bad');return}$('pay').disabled=true;msg('Creating secure payment…');try{const r=await fetch(`${API}/api/beats/${beat.id}/pay`,{method:'POST',headers:{Authorization:'Bearer '+s.access_token,'Content-Type':'application/json'},body:JSON.stringify({package_type:license,provider:method,customer_name:name,customer_email:email,customer_phone:phone,message:$('message').value.trim()})});const d=await r.json();if(!r.ok)throw Error(d.error||'Could not create payment order');const order=d.order;if(!order?.id)throw Error('Server did not return a payment order.');if(method==='FLUTTERWAVE'){const cr=await fetch(`${API}/api/beats/${beat.id}/card-checkout`,{method:'POST',headers:{Authorization:'Bearer '+s.access_token,'Content-Type':'application/json'},body:JSON.stringify({order_id:order.id,package_type:license})});const cd=await cr.json();if(!cr.ok)throw Error(cd.error||'Card checkout route is not available on the current backend.');if(!cd.checkout_url)throw Error('Card provider did not return a checkout link.');location.href=cd.checkout_url;return}const mr=await fetch(`${API}/api/beats/${beat.id}/mobile-money-checkout`,{method:'POST',headers:{Authorization:'Bearer '+s.access_token,'Content-Type':'application/json'},body:JSON.stringify({order_id:order.id,package_type:license,network:method,phone})});const md=await mr.json();if(!mr.ok)throw Error(md.error||'Mobile-money checkout route is not available on the current backend.');if(md.authorization_url)window.open(md.authorization_url,'_blank');msg('Payment request sent. Approve it on your phone, then keep this page open.');poll(order.id,s)}catch(e){console.error(e);msg(e.message||'Payment failed. No payment was confirmed.','bad');$('pay').disabled=false}}
function poll(orderId,s){let n=0;const timer=setInterval(async()=>{n++;try{const r=await fetch(`${API}/api/beats/mobile-money/status?order_id=${encodeURIComponent(orderId)}`,{headers:{Authorization:'Bearer '+s.access_token}}),d=await r.json();if(d.paid){clearInterval(timer);msg('Payment verified. Your beat purchase is complete.','ok');$('pay').textContent='✓ Payment Successful';return}if(n>=60){clearInterval(timer);msg('Payment is still pending. Check your PASONG account before trying again.');$('pay').disabled=false}}catch{}},5000)}
document.querySelectorAll('.method').forEach(b=>b.onclick=()=>{document.querySelectorAll('.method').forEach(x=>x.classList.remove('active'));b.classList.add('active');method=b.dataset.method;$('mobileBox').classList.toggle('hidden',method==='FLUTTERWAVE');updateButton()});$('pay').onclick=pay;load();const payment=q.get('payment');if(payment==='success')msg('Payment callback received. Check your order status for verified completion.','ok');if(payment==='failed')msg('Payment was not completed.','bad');if(payment==='error')msg(q.get('message')||'Payment could not be completed.','bad');
</script></body></html>
