/* =========================================================
   PASONG — PREMIUM NAVIGATION
   File: premium-nav.js
   ========================================================= */

(function () {
  "use strict";

  const PREMIUM_PAGE = "premium.html";
  const PREMIUM_BUTTON_ID = "pasongPremiumNavButton";

  function addPremiumButton() {
    /*
      Find the navigation action area.
      Example:
      <div class="nav-actions">...</div>
    */
    const navActions = document.querySelector(".nav-actions");

    if (!navActions) {
      return false;
    }

    /*
      Do not create the button twice.
    */
    if (document.getElementById(PREMIUM_BUTTON_ID)) {
      return true;
    }

    /*
      Create Premium button.
    */
    const premiumButton = document.createElement("a");

    premiumButton.id = PREMIUM_BUTTON_ID;
    premiumButton.href = PREMIUM_PAGE;
    premiumButton.className = "premium-nav-btn";
    premiumButton.title = "PASONG Premium";
    premiumButton.setAttribute(
      "aria-label",
      "PASONG Premium"
    );

    premiumButton.innerHTML = `
      <span class="premium-star">✦</span>
      <span class="premium-text">PREMIUM</span>
    `;

    /*
      Insert Premium at the beginning of the navigation.
    */
    navActions.insertBefore(
      premiumButton,
      navActions.firstChild
    );

    return true;
  }


  /* =========================================================
     PREMIUM BUTTON STYLE
     ========================================================= */

  function addPremiumStyles() {
    if (document.getElementById("pasongPremiumNavStyles")) {
      return;
    }

    const style = document.createElement("style");

    style.id = "pasongPremiumNavStyles";

    style.textContent = `
      .premium-nav-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;

        min-height: 40px;
        padding: 0 16px;

        border-radius: 12px;

        border: 1px solid rgba(255, 215, 92, .35);

        background:
          linear-gradient(
            135deg,
            rgba(155, 108, 255, .22),
            rgba(255, 69, 159, .18)
          );

        color: #fff;

        text-decoration: none;

        font-size: 13px;
        font-weight: 900;

        white-space: nowrap;

        box-shadow:
          0 8px 25px rgba(155, 108, 255, .12);

        transition:
          transform .2s ease,
          border-color .2s ease,
          box-shadow .2s ease,
          background .2s ease;
      }

      .premium-nav-btn .premium-star {
        color: #ffd76a;
        font-size: 16px;
        line-height: 1;
      }

      .premium-nav-btn .premium-text {
        color: #fff;
      }

      .premium-nav-btn:hover {
        transform: translateY(-2px);

        border-color:
          rgba(255, 215, 92, .65);

        box-shadow:
          0 12px 30px
          rgba(155, 108, 255, .22);

        background:
          linear-gradient(
            135deg,
            rgba(155, 108, 255, .30),
            rgba(255, 69, 159, .24)
          );
      }

      .premium-nav-btn:active {
        transform: translateY(0);
      }

      .premium-nav-btn:focus-visible {
        outline: 2px solid #ffd76a;
        outline-offset: 3px;
      }


      /* =========================================
         MOBILE
         ========================================= */

      @media (max-width: 800px) {

        .premium-nav-btn {
          min-height: 36px;
          padding: 0 10px;
          border-radius: 10px;
          font-size: 11px;
        }

      }


      @media (max-width: 480px) {

        .premium-nav-btn {
          width: 38px;
          min-height: 36px;
          padding: 0;
        }

        .premium-nav-btn .premium-text {
          display: none;
        }

        .premium-nav-btn .premium-star {
          font-size: 17px;
        }

      }
    `;

    document.head.appendChild(style);
  }


  /* =========================================================
     START
     ========================================================= */

  function initPremiumNavigation() {
    addPremiumStyles();

    /*
      The navigation may load after this script,
      so try immediately first.
    */
    if (addPremiumButton()) {
      return;
    }

    /*
      Watch the page briefly in case the navigation
      is inserted dynamically.
    */
    const observer = new MutationObserver(function () {

      if (addPremiumButton()) {
        observer.disconnect();
      }

    });

    observer.observe(document.documentElement, {
      childList: true,
      subtree: true
    });

    /*
      Safety stop so the observer does not run forever.
    */
    setTimeout(function () {
      observer.disconnect();
    }, 10000);
  }


  /*
    Run after the document is ready.
  */
  if (document.readyState === "loading") {

    document.addEventListener(
      "DOMContentLoaded",
      initPremiumNavigation
    );

  } else {

    initPremiumNavigation();

  }

})();
