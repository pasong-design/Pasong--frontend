(function () {
  "use strict";

  if (window.__PASONG_PREMIUM_NAV__) return;
  window.__PASONG_PREMIUM_NAV__ = true;

  const PREMIUM_URL = "premium.html";

  function addStyles() {
    if (document.getElementById("pasong-premium-nav-style")) return;

    const style = document.createElement("style");
    style.id = "pasong-premium-nav-style";
    style.textContent = `
      .pasong-premium-link {
        min-height: 40px;
        padding: 0 13px;
        border-radius: 12px;
        border: 1px solid rgba(155,108,255,.30);
        background: linear-gradient(135deg,rgba(139,92,246,.18),rgba(236,72,153,.12));
        color: #d8b4fe !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 800;
        text-decoration: none !important;
        white-space: nowrap;
        transition: .2s;
      }
      .pasong-premium-link:hover {
        color: #fff !important;
        border-color: rgba(255,255,255,.20);
        transform: translateY(-1px);
      }
      @media (max-width:520px) {
        .pasong-premium-link {
          padding: 0 9px;
          font-size: 12px;
        }
      }
    `;
    document.head.appendChild(style);
  }

  function createLink() {
    const link = document.createElement("a");
    link.href = PREMIUM_URL;
    link.className = "pasong-premium-link";
    link.textContent = "✦ Premium";
    link.title = "PASONG Premium";
    link.setAttribute("aria-label", "PASONG Premium");
    return link;
  }

  function addPremiumButton() {
    if (!document.body) return;
    addStyles();

    if (document.querySelector(".pasong-premium-link")) return;

    const navActions = document.querySelector(".nav-actions");
    if (navActions) {
      navActions.insertBefore(createLink(), navActions.firstChild);
      return;
    }

    const headerRight = document.querySelector(".header-right");
    if (headerRight) {
      headerRight.insertBefore(createLink(), headerRight.firstChild);
      return;
    }

    const nav = document.querySelector("nav");
    if (nav) {
      const link = createLink();
      link.style.marginLeft = "auto";
      link.style.marginRight = "10px";
      nav.appendChild(link);
    }
  }

  function start() {
    addPremiumButton();

    const observer = new MutationObserver(function () {
      if (!document.querySelector(".pasong-premium-link")) {
        addPremiumButton();
      }
      if (document.querySelector(".pasong-premium-link")) {
        observer.disconnect();
      }
    });

    observer.observe(document.body, { childList: true, subtree: true });
    setTimeout(function () { observer.disconnect(); }, 10000);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start, { once: true });
  } else {
    start();
  }
})();
