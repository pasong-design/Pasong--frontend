
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  background:#080810;
  color:#fff;
  font-family:Arial,Helvetica,sans-serif;
  line-height:1.5;
}

a{
  color:inherit;
  text-decoration:none;
}

button,
input{
  font:inherit;
}

button{
  cursor:pointer;
}

/* =========================
   HEADER
========================= */

header{
  position:sticky;
  top:0;
  z-index:1000;
  background:rgba(8,8,16,.94);
  backdrop-filter:blur(18px);
  border-bottom:1px solid rgba(255,255,255,.07);
}

.navbar{
  width:100%;
  max-width:1450px;
  margin:auto;
  min-height:70px;
  padding:12px 22px;
  display:flex;
  align-items:center;
  gap:18px;
}

.logo{
  font-size:23px;
  font-weight:900;
  white-space:nowrap;
  letter-spacing:.3px;
}

.logo span{
  color:#c084fc;
}

.search-box{
  flex:1;
  max-width:450px;
  position:relative;
}

.search-box input{
  width:100%;
  height:43px;
  padding:0 15px 0 43px;
  border-radius:14px;
  border:1px solid rgba(255,255,255,.08);
  outline:none;
  color:#fff;
  background:#12121d;
}

.search-box input:focus{
  border-color:rgba(168,85,247,.55);
  box-shadow:0 0 0 3px rgba(168,85,247,.08);
}

.search-box input::placeholder{
  color:#77778a;
}

.search-icon{
  position:absolute;
  left:15px;
  top:10px;
  color:#9696a9;
}

.nav-links{
  margin-left:auto;
  display:flex;
  align-items:center;
  gap:4px;
}

.nav-links a{
  padding:10px 10px;
  border-radius:10px;
  color:#b8b8c8;
  font-size:12px;
  font-weight:700;
  white-space:nowrap;
}

.nav-links a:hover{
  color:#fff;
  background:rgba(168,85,247,.1);
}

.notification-link{
  position:relative;
}

.notification-count{
  position:absolute;
  top:1px;
  right:0;
  min-width:16px;
  height:16px;
  display:grid;
  place-items:center;
  padding:0 4px;
  border-radius:50px;
  background:#ec4899;
  color:#fff;
  font-size:9px;
  font-weight:800;
}

.account-box{
  display:flex !important;
  align-items:center;
  gap:8px;
  padding:6px 10px !important;
  min-height:42px;
  border:1px solid rgba(192,132,252,.35) !important;
  border-radius:12px !important;
  background:rgba(168,85,247,.08);
  color:#fff !important;
  text-decoration:none !important;
  transition:.2s ease;
  white-space:nowrap;
}

.account-box:hover{
  background:linear-gradient(135deg,#8b5cf6,#ec4899) !important;
  border-color:transparent !important;
  transform:translateY(-1px);
}

.account-photo{
  width:32px;
  height:32px;
  border-radius:50%;
  object-fit:cover;
  border:2px solid rgba(192,132,252,.65);
  background:#191927;
  flex-shrink:0;
}

.account-box-text{
  font-size:12px;
  font-weight:800;
  line-height:1;
}

/* =========================
   HERO
========================= */

.hero{
  width:100%;
  max-width:1450px;
  margin:auto;
  padding:35px 22px 18px;
}

.hero-box{
  position:relative;
  overflow:hidden;
  min-height:430px;
  padding:72px 55px;
  display:flex;
  align-items:center;
  border-radius:30px;
  background:
    radial-gradient(circle at 8% 15%,rgba(168,85,247,.34),transparent 30%),
    radial-gradient(circle at 88% 80%,rgba(236,72,153,.23),transparent 35%),
    linear-gradient(135deg,#151324,#0e0e19 60%,#15101f);
  border:1px solid rgba(168,85,247,.2);
  box-shadow:0 25px 80px rgba(0,0,0,.28);
}

.hero-cover{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center top;
  opacity:.34;
  transition:opacity .8s ease;
  z-index:0;
  filter:saturate(1.05);
}

.hero-cover-overlay{
  position:absolute;
  inset:0;
  z-index:1;
  background:
    linear-gradient(
      90deg,
      rgba(8,8,16,.97) 0%,
      rgba(8,8,16,.82) 42%,
      rgba(8,8,16,.48) 72%,
      rgba(8,8,16,.72) 100%
    );
}

.hero-box:before{
  content:"";
  position:absolute;
  width:450px;
  height:450px;
  right:-130px;
  top:-170px;
  border-radius:50%;
  border:1px solid rgba(192,132,252,.08);
  box-shadow:
    0 0 0 35px rgba(192,132,252,.025),
    0 0 0 75px rgba(192,132,252,.018);
  z-index:1;
}

.hero-box:after{
  content:"";
  position:absolute;
  width:280px;
  height:280px;
  right:60px;
  bottom:-180px;
  border-radius:50%;
  background:rgba(236,72,153,.16);
  filter:blur(60px);
  z-index:1;
}

.hero-content{
  position:relative;
  z-index:2;
  max-width:790px;
}

.hero-kicker{
  color:#c084fc;
  font-size:11px;
  letter-spacing:2.5px;
  font-weight:900;
  margin-bottom:14px;
}

.hero h1{
  font-size:clamp(43px,7vw,82px);
  line-height:.94;
  font-weight:900;
  letter-spacing:-2px;
}

.hero h1 span{
  background:linear-gradient(90deg,#a855f7,#ec4899);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.hero p{
  max-width:680px;
  margin:22px 0;
  color:#aaaabb;
  font-size:15px;
}

.hero-actions{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:44px;
  padding:0 18px;
  border-radius:12px;
  font-size:12px;
  font-weight:900;
  border:1px solid rgba(255,255,255,.08);
  transition:.2s ease;
}

.btn:hover{
  transform:translateY(-2px);
}

.btn-primary{
  background:linear-gradient(135deg,#8b5cf6,#ec4899);
  color:#fff;
  border:none;
  box-shadow:0 10px 30px rgba(168,85,247,.18);
}

.btn-secondary{
  background:#181825;
  color:#ddd;
}

.btn-secondary:hover{
  border-color:rgba(168,85,247,.4);
  background:#1d1b2b;
}

/* =========================
   QUICK NAV
========================= */

.quick-nav{
  max-width:1450px;
  margin:auto;
  padding:12px 22px 30px;
  display:flex;
  gap:9px;
  overflow-x:auto;
  scrollbar-width:none;
}

.quick-nav::-webkit-scrollbar{
  display:none;
}

.quick-nav a{
  flex:0 0 auto;
  padding:10px 15px;
  border-radius:999px;
  background:#12121d;
  border:1px solid rgba(255,255,255,.07);
  color:#bcbccc;
  font-size:11px;
  font-weight:800;
  transition:.2s;
}

.quick-nav a:hover{
  color:#fff;
  border-color:rgba(168,85,247,.4);
  background:rgba(168,85,247,.1);
}

/* =========================
   CONTENT
========================= */

.container{
  width:100%;
  max-width:1450px;
  margin:auto;
  padding:0 22px;
}

.section{
  padding:23px 0;
}

.section-heading{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
  margin-bottom:14px;
}

.section-heading h2{
  font-size:20px;
  font-weight:900;
}

.section-heading a{
  color:#c084fc;
  font-size:11px;
  font-weight:800;
}

.uganda-label{
  display:block;
  color:#77778a;
  font-size:9px;
  margin-top:2px;
}

.music-row{
  min-height:150px;
  padding:17px;
  border-radius:19px;
  background:#10101a;
  border:1px solid rgba(255,255,255,.06);
  display:flex;
  gap:13px;
  overflow-x:auto;
  scrollbar-width:none;
}

.music-row::-webkit-scrollbar{
  display:none;
}

.loading-music,
.empty-music{
  width:100%;
  min-height:110px;
  display:grid;
  place-items:center;
  color:#666678;
  font-size:12px;
}

.song-card{
  flex:0 0 205px;
  min-width:205px;
  background:#151520;
  border:1px solid rgba(255,255,255,.07);
  border-radius:16px;
  overflow:hidden;
  transition:.2s ease;
}

.song-card:hover{
  transform:translateY(-4px);
  border-color:rgba(168,85,247,.38);
  box-shadow:0 12px 35px rgba(0,0,0,.25);
}

.song-cover{
  width:100%;
  height:150px;
  object-fit:cover;
  display:block;
  background:#191927;
}

.song-info{
  padding:12px;
}

.song-title{
  font-size:13px;
  font-weight:900;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.song-artist{
  color:#9292a4;
  font-size:10px;
  margin-top:3px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.song-bottom{
  margin-top:10px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:7px;
}

.song-price{
  color:#c084fc;
  font-size:11px;
  font-weight:900;
}

.song-play{
  border:0;
  width:34px;
  height:34px;
  border-radius:50%;
  background:linear-gradient(135deg,#8b5cf6,#ec4899);
  color:#fff;
  display:grid;
  place-items:center;
  font-size:13px;
}

.song-open{
  margin-top:9px;
  width:100%;
  min-height:32px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:9px;
  background:#1b1b29;
  border:1px solid rgba(255,255,255,.07);
  color:#cfcfda;
  font-size:10px;
  font-weight:800;
}

.song-open:hover{
  background:rgba(168,85,247,.1);
  color:#fff;
}

/* =========================
   DJ MIX PANEL
========================= */

.dj-mix-section{
  position:relative;
}

.dj-mix-header-text{
  display:flex;
  flex-direction:column;
}

.dj-mix-subtitle{
  color:#77778a;
  font-size:9px;
  margin-top:2px;
}

.dj-mix-panel{
  min-height:250px;
  padding:17px;
  border-radius:19px;
  background:
    radial-gradient(circle at 0% 50%,rgba(139,92,246,.12),transparent 35%),
    radial-gradient(circle at 100% 0%,rgba(236,72,153,.08),transparent 30%),
    linear-gradient(135deg,#10101a,#13111e);
  border:1px solid rgba(168,85,247,.15);
  display:flex;
  gap:14px;
  overflow-x:auto;
  scrollbar-width:none;
}

.dj-mix-panel::-webkit-scrollbar{
  display:none;
}

.dj-mix-card{
  flex:0 0 250px;
  min-width:250px;
  background:#151520;
  border:1px solid rgba(255,255,255,.07);
  border-radius:17px;
  overflow:hidden;
  transition:.2s ease;
}

.dj-mix-card:hover{
  transform:translateY(-4px);
  border-color:rgba(168,85,247,.42);
  box-shadow:0 15px 40px rgba(0,0,0,.30);
}

.dj-mix-cover{
  width:100%;
  height:155px;
  display:block;
  object-fit:cover;
  background:#191927;
}

.dj-mix-info{
  padding:12px;
}

.dj-mix-title{
  font-size:13px;
  font-weight:900;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.dj-mix-dj{
  margin-top:3px;
  color:#9292a4;
  font-size:10px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.dj-mix-free{
  margin-top:8px;
  color:#c084fc;
  font-size:10px;
  font-weight:900;
}

.dj-mix-price{
  margin-top:2px;
  color:#fff;
  font-size:11px;
  font-weight:900;
}

.dj-mix-actions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:7px;
  margin-top:10px;
}

.dj-mix-stream,
.dj-mix-buy,
.dj-mix-tip{
  min-height:34px;
  border-radius:9px;
  border:1px solid rgba(255,255,255,.07);
  font-size:9px;
  font-weight:900;
  color:#fff;
}

.dj-mix-stream{
  background:#1b1b29;
}

.dj-mix-stream:hover{
  background:rgba(168,85,247,.13);
}

.dj-mix-buy{
  background:linear-gradient(135deg,#8b5cf6,#ec4899);
  border:none;
}

.dj-mix-buy:hover{
  opacity:.9;
}

.dj-mix-tip{
  width:100%;
  margin-top:7px;
  background:rgba(236,72,153,.10);
  border-color:rgba(236,72,153,.22);
  color:#f5b4d2;
}

.dj-mix-tip:hover{
  background:rgba(236,72,153,.18);
  color:#fff;
}

.dj-mix-open{
  display:flex;
  align-items:center;
  justify-content:center;
  width:100%;
  min-height:31px;
  margin-top:7px;
  border-radius:9px;
  background:#11111b;
  border:1px solid rgba(255,255,255,.06);
  color:#aaaabb;
  font-size:9px;
  font-weight:800;
}

.dj-mix-open:hover{
  color:#fff;
  border-color:rgba(168,85,247,.3);
}

.dj-mix-empty{
  width:100%;
  min-height:190px;
  display:grid;
  place-items:center;
  text-align:center;
  color:#666678;
  font-size:12px;
}

.dj-mix-loading{
  width:100%;
  min-height:190px;
  display:grid;
  place-items:center;
  color:#666678;
  font-size:12px;
}

@media(max-width:600px){

  .dj-mix-panel{
    padding:14px;
    gap:11px;
  }

  .dj-mix-card{
    flex:0 0 220px;
    min-width:220px;
  }

  .dj-mix-cover{
    height:140px;
  }

}

/* =========================
   MINI PLAYER
========================= */

.mini-player{
  position:fixed;
  left:50%;
  bottom:20px;
  transform:translateX(-50%);
  width:min(600px,calc(100% - 28px));
  padding:11px 13px;
  border-radius:16px;
  background:rgba(17,17,29,.97);
  border:1px solid rgba(168,85,247,.25);
  box-shadow:0 15px 50px rgba(0,0,0,.45);
  backdrop-filter:blur(18px);
  z-index:1900;
  display:none;
  align-items:center;
  gap:11px;
}

.mini-player.show{
  display:flex;
}

.mini-player-info{
  flex:1;
  min-width:0;
}

.mini-player-title{
  font-size:12px;
  font-weight:800;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.mini-player-label{
  color:#888899;
  font-size:10px;
}

.mini-player audio{
  width:170px;
  height:34px;
}

.mini-player-close{
  width:30px;
  height:30px;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.08);
  background:#191927;
  color:#aaa;
}

/* =========================
   GENRES
========================= */

.genre-grid{
  display:grid;
  grid-template-columns:repeat(9,1fr);
  gap:9px;
}

.genre-card{
  padding:17px 8px;
  text-align:center;
  border-radius:14px;
  background:#11111b;
  border:1px solid rgba(255,255,255,.06);
  color:#c8c8d3;
  font-size:10px;
  font-weight:800;
  transition:.2s;
}

.genre-card:hover{
  transform:translateY(-3px);
  border-color:rgba(168,85,247,.35);
  color:#fff;
  background:rgba(168,85,247,.07);
}

/* =========================
   COUNTDOWN
========================= */

.countdown{
  position:relative;
  overflow:hidden;
  padding:34px;
  border-radius:22px;
  background:
    radial-gradient(circle at 20% 50%,rgba(168,85,247,.16),transparent 35%),
    linear-gradient(120deg,rgba(168,85,247,.12),rgba(236,72,153,.06)),
    #11111b;
  border:1px solid rgba(168,85,247,.14);
  text-align:center;
}

.countdown h2{
  font-size:24px;
  margin-bottom:5px;
}

.countdown p{
  color:#9999aa;
  font-size:12px;
}

/* =========================
   WHY PASONG
========================= */

.why-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:13px;
}

.why-card{
  padding:25px;
  border-radius:18px;
  background:#10101a;
  border:1px solid rgba(255,255,255,.06);
  transition:.2s;
}

.why-card:hover{
  transform:translateY(-3px);
  border-color:rgba(168,85,247,.25);
}

.why-icon{
  font-size:25px;
  margin-bottom:12px;
}

.why-card h3{
  font-size:15px;
  margin-bottom:6px;
}

.why-card p{
  color:#9999aa;
  font-size:11px;
}

/* =========================
   FEATURE BOXES
========================= */

.feature-box{
  padding:30px;
  border-radius:21px;
  background:
    radial-gradient(circle at 100% 0,rgba(168,85,247,.08),transparent 30%),
    #10101a;
  border:1px solid rgba(255,255,255,.06);
}

.feature-box h2{
  font-size:20px;
  margin-bottom:8px;
}

.feature-box p{
  color:#9d9dad;
  font-size:12px;
  margin-bottom:18px;
}

.payment-badges{
  display:flex;
  flex-wrap:wrap;
  gap:9px;
  margin-bottom:18px;
}

.payment-badge{
  padding:10px 14px;
  border-radius:10px;
  background:#171722;
  border:1px solid rgba(255,255,255,.07);
  font-size:11px;
  font-weight:800;
}

/* =========================
   FOOTER
========================= */

footer{
  margin-top:50px;
  padding:45px 22px 90px;
  border-top:1px solid rgba(255,255,255,.07);
  background:#07070d;
}

.footer-inner{
  width:100%;
  max-width:1450px;
  margin:auto;
}

.footer-logo{
  font-size:21px;
  font-weight:900;
  margin-bottom:7px;
}

.footer-inner p{
  color:#77778a;
  font-size:11px;
  max-width:550px;
}

.footer-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:30px;
  margin-top:28px;
}

.footer-column h4{
  font-size:12px;
  margin-bottom:10px;
}

.footer-column a{
  display:block;
  margin:7px 0;
  color:#858596;
  font-size:11px;
}

.footer-column a:hover{
  color:#c084fc;
}

/* =========================
   MOBILE NAV
========================= */

.mobile-bottom-nav{
  display:none;
}

@media(max-width:1100px){

  .nav-links a{
    padding:9px 7px;
    font-size:11px;
  }

  .genre-grid{
    grid-template-columns:repeat(5,1fr);
  }
}

@media(max-width:800px){

  .navbar{
    padding:10px 14px;
    flex-wrap:wrap;
  }

  .search-box{
    order:3;
    flex-basis:100%;
    max-width:none;
  }

  .nav-links{
    margin-left:auto;
  }

  .nav-links a{
    display:none;
  }

  .nav-links .notification-link,
  .nav-links .account-box{
    display:flex !important;
  }

  .hero{
    padding:28px 14px 20px;
  }

  .hero-box{
    min-height:390px;
    padding:48px 25px;
  }

  .container{
    padding:0 14px;
  }

  .why-grid{
    grid-template-columns:1fr;
  }

  .footer-grid{
    grid-template-columns:1fr;
  }
}

@media(max-width:600px){

  body{
    padding-bottom:70px;
  }

  .logo{
    font-size:20px;
  }

  .account-box{
    padding:5px 8px !important;
    gap:6px;
  }

  .account-photo{
    width:34px;
    height:34px;
  }

  .account-box-text{
    font-size:10px;
  }

  .hero h1{
    font-size:43px;
    letter-spacing:-1.5px;
  }

  .hero-box{
    min-height:420px;
    padding:38px 20px;
    border-radius:22px;
  }

  .hero p{
    font-size:13px;
  }

  .hero-actions{
    display:grid;
    grid-template-columns:1fr;
  }

  .btn{
    width:100%;
  }

  .quick-nav{
    padding-left:14px;
    padding-right:14px;
  }

  .genre-grid{
    grid-template-columns:repeat(3,1fr);
  }

  .section-heading h2{
    font-size:18px;
  }

  .song-card{
    flex-basis:175px;
    min-width:175px;
  }

  .song-cover{
    height:130px;
  }

  .mini-player{
    bottom:76px;
  }

  .mini-player audio{
    width:115px;
  }

  .mobile-bottom-nav{
    position:fixed;
    left:0;
    right:0;
    bottom:0;
    z-index:2000;
    height:65px;
    display:grid;
    grid-template-columns:repeat(5,1fr);
    background:rgba(10,10,18,.97);
    backdrop-filter:blur(18px);
    border-top:1px solid rgba(255,255,255,.08);
  }

  .mobile-bottom-nav a{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:2px;
    color:#858596;
    font-size:10px;
    font-weight:700;
  }

  .mobile-bottom-nav a span{
    font-size:19px;
    line-height:20px;
  }

  .mobile-bottom-nav a:hover{
    color:#c084fc;
  }

  footer{
    padding-bottom:90px;
  }
}
